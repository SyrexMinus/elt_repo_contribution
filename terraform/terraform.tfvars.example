aws_region  = "eu-central-1"
environment = "demo"
name_prefix = "elt-repo-contribution"

repositories      = ["ClickHouse/ClickHouse", "hashicorp/terraform"]
ingestion_cadence = "0 */6 * * *" # 6h

bronze_retention_days = 7
monthly_budget_usd    = 10
alert_email           = "ops@example.com"

airflow_instance_type = "t3.micro"
airflow_image         = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/elt-repo-contribution-airflow@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
airflow_ssh_key_name  = "my-ec2-keypair"
airflow_allowed_cidr  = "203.0.113.0/32" # TODO

snowflake_account        = "xy12345.eu-central-1"
snowflake_user           = "ELT_TERRAFORM"
snowflake_role           = "SYSADMIN"
snowflake_warehouse_size = "XSMALL"
snowflake_runtime_user   = "ELT_PIPELINE"
silver_image            = "123456789012.dkr.ecr.eu-central-1.amazonaws.com/elt-repo-contribution-silver@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
github_token_ssm_parameter       = "/elt/demo/github-token"
snowflake_password_ssm_parameter = "/elt/demo/snowflake-password"
