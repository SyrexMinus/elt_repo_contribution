#!/usr/bin/env bash
set -euo pipefail

dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -SL https://github.com/docker/compose/releases/latest/download/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/airflow/dags

cat > /opt/airflow/.env <<'EOF'
INGESTION_CADENCE=${ingestion_cadence}
REPOSITORIES=${repositories}
BRONZE_BUCKET=${bronze_bucket}
ARTIFACTS_BUCKET=${artifacts_bucket}
SPARK_APPLICATION_ID=${spark_application_id}
EOF

echo "STUB: Airflow stack not started. See stages/airflow_dags/ for the DAG stub." >> /var/log/airflow-bootstrap.log
