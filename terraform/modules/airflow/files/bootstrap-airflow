#!/usr/bin/env bash
set -euo pipefail

rm -f /opt/airflow/.bootstrap-complete
dnf install -y docker iptables-services \
  https://s3.amazonaws.com/ec2-downloads-windows/SSMAgent/latest/linux_amd64/amazon-ssm-agent.rpm
printf 'net.ipv4.ip_forward=1\n' > /etc/sysctl.d/99-pipeline-nat.conf
sysctl --system >/dev/null
iptables -t nat -A POSTROUTING -s 10.42.1.0/24 -j MASQUERADE
iptables -I FORWARD -s 10.42.1.0/24 -j ACCEPT
iptables -I FORWARD -d 10.42.1.0/24 -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
service iptables save
systemctl enable iptables
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fSL https://github.com/docker/compose/releases/download/v5.4.0/docker-compose-linux-x86_64 \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
mkdir -p /opt/airflow/data /opt/airflow/logs
chown -R 50000:0 /opt/airflow/data /opt/airflow/logs
touch /opt/airflow/.bootstrap-complete
systemctl enable --now amazon-ssm-agent
